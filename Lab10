import math
def f(x):
    return x**2 - math.log(x)
def f_prime(x):
    return 2*x - 1/x
def newton_method(x0, tol=1e-6, max_iter=100):
    for _ in range(max_iter):
        if x0 <= 0:  
            return None
        fx0 = f(x0)
        fx0_prime = f_prime(x0)
        if fx0_prime == 0: 
            return None
        x1 = x0 - fx0 / fx0_prime
        if abs(x1 - x0) < tol:  
            return x1
        x0 = x1
    return None
x0 = 1.5
root = newton_method(x0)
if root is not None:
    print(f"Təqribi kök: {root}")
else:
    print("Kök tapılmadı.")
